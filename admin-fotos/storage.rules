rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
    function albumIsPublic(albumId) {
      return firestore.get(/databases/(default)/documents/albums/$(albumId)).data.published == true;
    }

    match /albums/{albumId}/{fileName} {
      allow read: if isAdmin() || albumIsPublic(albumId);
      allow write: if isAdmin()
        && request.resource != null
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif|avif)');
      allow delete: if isAdmin();
    }
  }
}
